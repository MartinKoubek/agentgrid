#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
module_dir="$(cd "$script_dir/.." && pwd)"
repo_root="$(cd "$module_dir/.." && pwd)"
tmux_module_dir="$repo_root/agentgrid-tmux"

export PYTHONPATH="$module_dir:$tmux_module_dir${PYTHONPATH:+:$PYTHONPATH}"
exec "${PYTHON:-python3.11}" -m agentgrid_agent.cli "$@"
